# ─── Wallet ───────────────────────────────────────────────────────────────────
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ─── DreamDEX / Somnia Network ───────────────────────────────────────────────
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_WS_URL=wss://dream-rpc.somnia.network
SOMNIA_CHAIN_ID=50312
DREAMDEX_INDEXER_URL=https://markets-indexer.dreamdex.io

# ─── Bot Config ──────────────────────────────────────────────────────────────
# Trade size in tUSDC (human units, e.g. 1 = 1 tUSDC)
DREAMDEX_TRADE_SIZE=1

# Enable/disable individual task flows
DREAMDEX_ENABLE_FAUCET=true
DREAMDEX_ENABLE_TRADE=true
DREAMDEX_ENABLE_REDEEM=true

# Minimum seconds left on a market before considering it tradable
DREAMDEX_MIN_EXPIRY_SECONDS=300

# IOC price slippage added on top of best ask (probability units)
DREAMDEX_SLIPPAGE=0.02
